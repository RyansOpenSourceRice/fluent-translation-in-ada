with "../../fluent_translation_in_ada.gpr";

project Parse is
   for Source_Dirs use ("src");
   for Object_Dir use "../../obj/parse";
   for Exec_Dir use "../../bin";
   for Create_Missing_Dirs use "True";
   for Main use ("parse.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatW8", "-O2");
   end Compiler;
end Parse;
