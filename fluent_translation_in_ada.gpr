--
--  fluent_translation_in_ada.gpr - GNAT project for the Fluent FTL library.
--  Target: GNAT FSF 16 / GNAT Pro 26 family, Ada 2022, SPARK Silver.
--  Strings: VSS Virtual_String (UTF-8 sources via -gnatW8).

with "vss_text.gpr";

project Fluent_Translation_In_Ada is

   for Library_Name use "fluent_translation_in_ada";
   for Library_Kind use "static";
   for Library_Version use Project'Library_Name & ".so.0.1.0";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";

   package Naming is
      for Spec_Suffix ("Ada") use ".ads";
      for Body_Suffix ("Ada") use ".adb";
   end Naming;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnatW8",
         "-gnatwa",
         "-gnatVa",
         "-gnata",
         "-gnato",
         "-O2");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--mode=silver",
         "--level=2",
         "--checks-as-errors=on",
         "--warnings=continue");
   end Prove;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

end Fluent_Translation_In_Ada;
